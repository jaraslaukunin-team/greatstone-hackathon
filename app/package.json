{
  "name": "app",
  "version": "0.0.1",
  "private": true,
  "main": "entry.js",
  "scripts": {
    "copy:canvaskit": "node scripts/copy-canvaskit.mjs",
    "start": "node scripts/copy-canvaskit.mjs && expo start",
    "android": "node scripts/copy-canvaskit.mjs && expo start --android",
    "ios": "node scripts/copy-canvaskit.mjs && expo start --ios",
    "web": "node scripts/copy-canvaskit.mjs && expo start --web",
    "web:build": "node scripts/copy-canvaskit.mjs && expo export -p web",
    "test": "jest"
  },
  "dependencies": {
    "@picpac/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "^5.62.8",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~2.29.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.(spec|test).[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@picpac/shared$": "<rootDir>/../packages/shared/src/index.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@picpac/shared|zustand|@tanstack/.*)"
    ]
  }
}
