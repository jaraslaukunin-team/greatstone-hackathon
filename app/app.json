{
  "expo": {
    "name": "PicPac",
    "slug": "picpac",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "picpac",
    "userInterfaceStyle": "automatic",
    "extra": {
      "apiUrl": "https://picpac.jaraslau.dev",
      "eas": {
        "projectId": "3bab2969-094e-478a-a913-9f376104de9a"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "by.picpac.app"
    },
    "android": {
      "package": "by.picpac.app",
      "adaptiveIcon": {
        "backgroundColor": "#DD5757",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "picpac",
              "host": "invite",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6EFE6"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "mioryyy"
  }
}
