# HTTPS для API и веб-версии приложения. API_DOMAIN: домен или <ip-сервера>.nip.io, тогда сертификат Caddy получает сам.
# Без API_DOMAIN используется localhost (самоподписанный сертификат, для проверки на своей машине).
# Веб-версия лежит в ./web (сборка: npm run web:build -w app). Браузерные переходы по страницам отдают сайт,
# все остальные запросы (fetch, файлы, программы) идут в API на том же домене, поэтому CORS не нужен.
#
# Только h1/h2: HTTP/3 (QUIC/UDP) на мобильном интернете часто даёт «Network request failed» в React Native,
# при том что с ПК по TCP всё ок.
{
	servers {
		protocols h1 h2
	}
}

{$API_DOMAIN:localhost} {
	encode zstd gzip

	# Браузер дальше ходит на домен только по HTTPS.
	header Strict-Transport-Security "max-age=31536000"
	# Не рекламируем h3, даже если образ Caddy умеет QUIC.
	header -Alt-Svc

	# canvaskit.wasm — движок Skia для фоторедактора в браузере (не в API).
	@assets path /_expo/* /assets/* /favicon.ico /canvaskit.wasm
	handle @assets {
		root * /srv/web
		@wasm path /canvaskit.wasm
		header @wasm Content-Type application/wasm
		file_server
	}

	@page {
		method GET HEAD
		header Accept *text/html*
		not path /health
	}
	handle @page {
		root * /srv/web
		try_files {path} /index.html
		# Страницу не кэшируем: после обновления пользователи сразу получают новую сборку (скрипты в _expo с хэшами в именах).
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy api:3000
	}
}
