# Значения-примеры для локальной разработки; настоящие секреты задаются только в .env на VPS.
# Для запуска через docker compose обязательны JWT_SECRET и FILE_URL_SECRET (любые длинные случайные строки).
DATABASE_URL=postgres://picpac:picpac@localhost:5433/picpac
DATABASE_URL_TEST=postgres://picpac:picpac@localhost:5433/picpac_test
JWT_SECRET=
FILE_URL_SECRET=
UPLOAD_DIR=
# true: вход по коду 000000 (только для демо и тестов, на боевом сервере выключить)
DEMO_MODE=
# stub (готовая картинка) или aiai
AI_PROVIDER=
AIAI_BASE_URL=
AIAI_API_KEY=
AIAI_MODEL=
# images или chat: какой режим работает, покажет npm run ai:probe -w api
AIAI_EDIT_MODE=
# Домен API для HTTPS (или <ip-сервера>.nip.io); без него Caddy работает на localhost
API_DOMAIN=
# Пароль базы в docker compose (по умолчанию picpac): на сервере обязательно сменить
# POSTGRES_PASSWORD=
# Образ БД для docker compose (по умолчанию postgres:16)
# POSTGRES_IMAGE=postgres:16
# Порты Caddy на хосте (по умолчанию 80 и 443)
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
